{
  "name": "@pap/shared",
  "version": "1.0.0",
  "description": "Shared types and schemas for Product Automation Pipeline",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts"
  },
  "keywords": ["types", "shared"],
  "author": "Chris",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
