{
  "name": "@pap/backend",
  "version": "1.0.0",
  "description": "Backend server for Product Automation Pipeline",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test:airtable": "tsx ../../tests/integration/test-airtable.ts",
    "test:ado": "tsx ../../tests/integration/test-ado.ts",
    "test:bedrock": "tsx ../../tests/integration/test-bedrock.ts",
    "validate-env": "tsx src/utils/validate-env.ts",
    "verify-schema": "tsx ../../scripts/verify-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "keywords": [
    "backend",
    "api",
    "express"
  ],
  "author": "Chris",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pap/shared": "file:../shared",
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.3.0",
    "uuid": "^9.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "figma-mcp": "^0.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
