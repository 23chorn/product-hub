# @xcube/pipeline — environment configuration
# Copy this file to .env in this directory (or set vars in your shell profile).
#
# Installation:
#   cd packages/pipeline
#   npm install
#   npm run build
#   npm link          # makes `pipeline` available globally, OR:
#   npm install -g .  # install globally
#
# Usage:
#   pipeline run --init=21 --phase=mvp --stream=ios
#   pipeline run --init=21 --phase=mvp --stream=ios --mode=headless
#
# The CLI connects to a running product-hub server. Point PIPELINE_API_URL at
# wherever your team's product-hub is deployed (or localhost for local dev).

# URL of the running product-hub server (no trailing slash)
PIPELINE_API_URL=http://172.24.160.104:5173

# API key — must match PIPELINE_API_KEY in the product-hub server's .env
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PIPELINE_API_KEY=

# Path to the local git repository where Claude Code will be launched.
# Defaults to the current working directory when the CLI is run.
# PIPELINE_WORKSPACE=C:\path\to\your\repo
