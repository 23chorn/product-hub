# @xcube/pipeline — environment configuration
# Place this file (or a .env containing the variables below) in the root of the
# repository you will be coding in. The CLI loads .env from wherever you run it.

# URL of the running product-hub server (no trailing slash)
PIPELINE_API_URL=http://your-product-hub-host:3001

# API key — must match PIPELINE_API_KEY in the product-hub server's .env
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIPELINE_API_KEY=

# Path to the local git repository where Claude Code will be launched.
# Defaults to the current working directory when the CLI is run.
# PIPELINE_WORKSPACE=C:\path\to\your\repo
