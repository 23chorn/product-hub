{
  "name": "product-automation-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered Product Requirements Document and backlog automation",
  "workspaces": [
    "app/frontend",
    "app/backend",
    "app/shared"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=app/shared",
    "predev": "npm run build --workspace=app/shared",
    "dev:backend": "cd app/backend && npm run dev",
    "dev:frontend": "cd app/frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test:airtable": "cd app/backend && npm run test:airtable",
    "test:gitbook": "cd app/backend && npm run test:gitbook",
    "test:ado": "cd app/backend && npm run test:ado",
    "test:bedrock": "cd app/backend && npm run test:bedrock",
    "test:integrations": "npm run test:airtable && npm run test:gitbook && npm run test:ado && npm run test:bedrock",
    "build": "npm run build --workspace=app/shared && npm run build --workspace=app/backend && npm run build --workspace=app/frontend",
    "start": "node app/backend/dist/app/backend/src/server.js",
    "lint": "npm run lint --workspaces",
    "validate-env": "cd app/backend && npm run validate-env",
    "verify-schema": "tsx scripts/verify-schema.ts",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd app/backend && npm run test",
    "test:frontend": "cd app/frontend && npm run test",
    "test:pipeline": "tsx scripts/test-pipeline.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "figma-developer-mcp": "^0.7.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.992.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2"
  }
}
