```mermaid
flowchart TD
    %% ── INPUT ──────────────────────────────────────────────────────────────
    AT[(Airtable\nRoadmap)] -->|sync initiative| ITEM
    MANUAL([PM types goal]) --> ITEM[items table\nSQLite]

    %% ── CONTEXT FILES ──────────────────────────────────────────────────────
    subgraph CTX["context/ (injected into every agent system prompt)"]
        C1[company.md]
        C2[strategy.md]
        C3[current-state.md]
        C4[tech-stack.md]
        C5[process.md]
        C6[db-schema.md\nrepos.md\napi-contracts.md\n... stage-scoped files]
    end

    %% ── COORDINATOR ────────────────────────────────────────────────────────
    ITEM --> COORD[Coordinator Agent\n'Chief of Staff']
    CTX -->|all context files| COORD
    COORD -->|COORDINATOR_READY +\nenriched context JSON| PLAN{PM reviews\nstage plan}
    PLAN -->|approve / toggle stages| WF[Workflow created\nstage_sequence locked]

    %% ── STAGE 1: ANALYST ───────────────────────────────────────────────────
    WF --> A1[Analyst — Sage\nresearch.template.md]
    CTX --> A1
    A1 -->|analyst JSON artifact| CR1[Inline Critic]
    CR1 -->|auto-revise ×2 max| A1
    CR1 -->|approve| CP1{Human\nCheckpoint}
    CP1 -->|edit / save| A1
    CP1 -->|approve →\nWiki sync| WIKI[(Azure Wiki)]

    %% ── STAGE 2: PM PRD ────────────────────────────────────────────────────
    CP1 --> A2[PM — Rex\nprd.template.md]
    CTX --> A2
    A1 -->|analyst artifact| A2
    A2 -->|prd JSON artifact| CR2[Inline Critic]
    CR2 -->|auto-revise ×2 max| A2
    CR2 -->|approve| CP2{Human\nCheckpoint}
    CP2 -->|approve →\nWiki sync| WIKI

    %% ── STAGE 3: ARCHITECT (optional) ──────────────────────────────────────
    CP2 --> A3[Architect — Atlas\narchitecture.template.md]
    CTX --> A3
    A2 -->|prd artifact| A3
    A3 -->|architecture JSON artifact| CR3[Inline Critic]
    CR3 -->|approve| CP3{Human\nCheckpoint}
    CP3 -->|approve →\nWiki sync| WIKI

    %% ── STAGE 4: EPIC FEATURE PLANNER ──────────────────────────────────────
    CP2 --> A4[Epic Feature Planner — Apex\nepic-features.template.md]
    CP3 -.->|arch artifact\n(if present)| A4
    CTX --> A4
    A2 -->|prd artifact| A4
    A4 -->|epic_features JSON\nF1 · F2 · F3 shells| CR4[Inline Critic]
    CR4 -->|approve| CP4{Human\nCheckpoint}
    CP4 -->|approve| ADO_EF[(ADO\nEpic + Feature shells\ncreated)]

    %% ── STAGE 5–7: STORY DECOMPOSITION F1, F2, F3 ──────────────────────────
    ADO_EF --> SD1

    subgraph MAR["Multi-Agent Refinement (per feature)"]
        SHARD["Shard — Product Owner\n(always)"]
        VERA["Vera — QA\n(always)"]
        FINN["Finn — Backend\n(always)"]
        REMI["Remi — Web\n(when web/desktop)"]
        IOS["Cole — iOS\n(when mobile/iOS)"]
        AND["Cole — Android\n(when mobile/Android)"]
    end

    SD1[Story Decomposition F1] --> MAR
    CTX --> SD1
    A2 -->|prd artifact| SD1
    A4 -->|epic_features artifact| SD1

    MAR -->|stories + test cases| CP5{Human\nCheckpoint}
    CP5 -->|approve| ADO_S1[(ADO\nF1 Stories + Test Plan)]

    ADO_S1 --> SD2[Story Decomposition F2]
    SD2 --> MAR2[Multi-Agent Refinement]
    MAR2 -->|stories + test cases| CP6{Human\nCheckpoint}
    CP6 -->|approve| ADO_S2[(ADO\nF2 Stories + Test Plan)]

    ADO_S2 --> SD3[Story Decomposition F3]
    SD3 --> MAR3[Multi-Agent Refinement]
    MAR3 -->|stories + test cases| CP7{Human\nCheckpoint}
    CP7 -->|approve| ADO_S3[(ADO\nF3 Stories + Test Plan)]

    %% ── STAGE 8: CURATOR ────────────────────────────────────────────────────
    ADO_S3 --> CUR[Curator — Ivy\nreads all artifacts]
    CUR -->|context_diffs proposals| CDIFF{PM reviews\ncontext diffs}
    CDIFF -->|approve| CTX

    %% ── FINAL OUTPUT ────────────────────────────────────────────────────────
    ADO_S1 --> IMPL
    ADO_S2 --> IMPL
    ADO_S3 --> IMPL
    IMPL[(Azure DevOps\nEpic › Features › Stories\n+ Test Plans)]

    %% ── STORAGE LAYER ───────────────────────────────────────────────────────
    subgraph STORE["Artifact Storage (transparent to agents)"]
        MONGO[(MongoDB\nJSON artifacts)]
        DISK[(Disk fallback\n/artifacts/)]
    end

    A1 & A2 & A3 & A4 --> STORE
    SD1 & SD2 & SD3 --> STORE

    %% ── STYLES ──────────────────────────────────────────────────────────────
    classDef agent fill:#1e3a5f,color:#e8f4f8,stroke:#4a9eca
    classDef checkpoint fill:#2d4a1e,color:#c8e6c9,stroke:#66bb6a
    classDef integration fill:#4a1e2d,color:#f8bbd0,stroke:#ef5350
    classDef context fill:#3a2d1e,color:#ffe0b2,stroke:#ffa726
    classDef storage fill:#1e1e3a,color:#c5cae9,stroke:#7986cb

    class A1,A2,A3,A4,SD1,SD2,SD3,COORD,CUR agent
    class CP1,CP2,CP3,CP4,CP5,CP6,CP7,PLAN,CDIFF checkpoint
    class AT,ADO_EF,ADO_S1,ADO_S2,ADO_S3,WIKI,IMPL integration
    class CTX,C1,C2,C3,C4,C5,C6 context
    class STORE,MONGO,DISK storage
```
