# ============================================
# Product Hub — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ────────────────────────────────────────────
# AI Provider
# ────────────────────────────────────────────
# Options: anthropic | bedrock | ollama
AI_PROVIDER=anthropic

# Anthropic direct API  (AI_PROVIDER=anthropic)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# AWS Bedrock  (AI_PROVIDER=bedrock)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Ollama local  (AI_PROVIDER=ollama)
# Install: https://ollama.com  |  pull: ollama pull llama3.2:1b
# OLLAMA_BASE_URL=http://localhost:11434

# ────────────────────────────────────────────
# Integrations
# ────────────────────────────────────────────
# roadmap:    none | airtable
# work_items: none | ado | jira
# knowledge:  none | notion | gitbook | azure_wiki
ROADMAP_INTEGRATION=none
WORK_ITEMS_INTEGRATION=none
KNOWLEDGE_BASE_INTEGRATION=none

# ────────────────────────────────────────────
# Airtable  (ROADMAP_INTEGRATION=airtable)
# ────────────────────────────────────────────
# Get key: https://airtable.com/account
# Base ID: open your base — URL is airtable.com/{BASE_ID}/...
# AIRTABLE_API_KEY=pat...
# AIRTABLE_BASE_ID=app...
# AIRTABLE_TABLE_NAME=Initiatives

# ────────────────────────────────────────────
# Azure DevOps  (WORK_ITEMS_INTEGRATION=ado)
# ────────────────────────────────────────────
# Create PAT: https://dev.azure.com/{org}/_usersSettings/tokens
# AZURE_DEVOPS_ORG=https://dev.azure.com/your-org
# AZURE_DEVOPS_PROJECT=YourProject
# AZURE_DEVOPS_PAT=...
# AZURE_DEVOPS_WIKI_ID=YourProject.wiki        # defaults to {sanitized-project}.wiki

# Work item type overrides (defaults match Agile process template)
# AZURE_DEVOPS_EPIC_TYPE=Epic
# AZURE_DEVOPS_FEATURE_TYPE=Feature
# AZURE_DEVOPS_STORY_TYPE=User Story           # Scrum: "Product Backlog Item"
# AZURE_DEVOPS_TASK_TYPE=Task

# AI estimation custom fields (optional)
# AZURE_DEVOPS_AI_EST_DEV_FIELD=Custom.AIEstDev
# AZURE_DEVOPS_AI_EST_QA_FIELD=Custom.AIEstQA

# AI coding pipeline trigger (optional)
# AZURE_DEVOPS_AI_PIPELINE_ID=123

# ────────────────────────────────────────────
# Jira  (WORK_ITEMS_INTEGRATION=jira)
# ────────────────────────────────────────────
# JIRA_HOST=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=...
# JIRA_PROJECT_KEY=PROJ
# JIRA_EPIC_TYPE=Epic
# JIRA_STORY_TYPE=Story
# JIRA_TASK_TYPE=Task

# ────────────────────────────────────────────
# Notion  (KNOWLEDGE_BASE_INTEGRATION=notion)
# ────────────────────────────────────────────
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=...

# ────────────────────────────────────────────
# GitBook  (KNOWLEDGE_BASE_INTEGRATION=gitbook)
# ────────────────────────────────────────────
# GITBOOK_API_TOKEN=gb_...

# ────────────────────────────────────────────
# Azure Wiki  (KNOWLEDGE_BASE_INTEGRATION=azure_wiki)
# ────────────────────────────────────────────
# Reuses the AZURE_DEVOPS_* credentials above — set those plus this flag to
# auto-publish analyst/PRD/architecture/prototype/figma_design drafts to the
# ADO wiki. Independent of WORK_ITEMS_INTEGRATION — set that to "none" if you
# only want the wiki, not ADO work items.
# GITBOOK_SPACE_ID=...
# GITBOOK_PUBLIC_URL=https://example.gitbook.io/docs/product/prds
# GITBOOK_PARENT_PATH=product/prds

# ────────────────────────────────────────────
# MongoDB — Artifact Document Store
# ────────────────────────────────────────────
# Start with Docker: docker compose up -d
# Falls back to disk storage automatically when unreachable.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=product-agent

# ────────────────────────────────────────────
# Figma  (optional — enriches prototype and figma_design stages)
# ────────────────────────────────────────────
# FIGMA_API_KEY=figd_...              # or FIGMA_ACCESS_TOKEN — both accepted
# FIGMA_DESIGN_SYSTEM_FILE=...        # Figma file key for your design system tokens
# FIGMA_MOCKUP_FILE=...               # Figma file key for existing mockups (optional; per-item keys override this)
# FIGMA_PROJECT_ID=...                # Project ID to place new files in (omit to use Drafts)

# ────────────────────────────────────────────
# Slack  (optional — checkpoint approval notifications)
# ────────────────────────────────────────────
# Create incoming webhook: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# APP_URL=http://localhost:5173        # base URL included in Slack notification links

# ────────────────────────────────────────────
# Server
# ────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=change-me-in-production    # signs session cookies — use a long random string in prod

# ────────────────────────────────────────────
# Debug / Local Dev
# ────────────────────────────────────────────
# LOG_LEVEL=debug
# DEBUG=*
# USE_MOCK_DATA=true                            # bypass Airtable for local dev
