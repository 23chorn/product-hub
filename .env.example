# ============================================
# Product Automation Pipeline - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# AI Provider
# ============================================
# Cost tiers — see docs/development/llm-cost-tiers.md for full guidance:
#   Tier 0 (default): AI_PROVIDER=ollama          — free, local, pipeline testing
#   Tier 1:           AI_PROVIDER=anthropic + Haiku — ~$0.001/run, output quality checks
#   Tier 2:           AI_PROVIDER=anthropic + Sonnet/Opus — ~$0.05–0.20/run, final acceptance
AI_PROVIDER=ollama

# --- Ollama (used when AI_PROVIDER=ollama) ---
# Install: https://ollama.com | Pull model: ollama pull llama3.2:1b
# OLLAMA_BASE_URL=http://localhost:11434  # default, override if needed

# --- Anthropic direct API (used when AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- AWS Bedrock (used when AI_PROVIDER=bedrock) ---
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=me-central-1

# ============================================
# Airtable
# ============================================
# Get your API key from: https://airtable.com/account
# Find Base ID: Open your base, URL format is airtable.com/{BASE_ID}/...
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Roadmap

# ============================================
# GitBook
# ============================================
# Create API token at: https://app.gitbook.com/account/developer
# Find Space ID in your space settings
GITBOOK_API_TOKEN=gb_...
GITBOOK_SPACE_ID=...
GITBOOK_PUBLIC_URL=https://xcube-1.gitbook.io/xcube-documents/product/prds
GITBOOK_PARENT_PATH=product/prds

# ============================================
# Azure DevOps
# ============================================
# Create PAT at: https://dev.azure.com/{org}/_usersSettings/tokens
# Org URL format: https://dev.azure.com/{your-org}
# Project name must match exactly
AZURE_DEVOPS_ORG=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=YourProject
AZURE_DEVOPS_PAT=...

# ============================================
# Server Configuration
# ============================================
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ============================================
# Feature Flags
# ============================================
# Workflow Mode enables the Coordinator-driven multi-stage pipeline UI.
# Defaults to true (enabled). Set to false to hide it without removing the feature —
# useful for staged rollout on shared instances. Local users can leave this unset.
# ENABLE_WORKFLOW_MODE=false

# ============================================
# Optional: Logging & Debugging
# ============================================
# LOG_LEVEL=debug
# DEBUG=*
